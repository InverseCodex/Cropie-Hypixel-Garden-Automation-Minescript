from minescript import echo

Minecraft = JavaClass("net.minecraft.client.Minecraft")

def isDigit(STRING):
    REF = "0123456789"

    if not STRING:
        return False
    for CHAR in STRING:
        if CHAR not in REF:
            return False
        
    return True

def getPest():
    mc = Minecraft.getInstance()
    CONNECTION = mc.getConnection()

    if CONNECTION is None:
        return []

    OVERLAY = mc.gui.hud.getTabList()
    PLAYERS = CONNECTION.getListedOnlinePlayers().toArray()

    RESULTS = [] # INITIALIZE AN EMPTY ARRAY TO STORE DATA LATER 

    for PLAYER in PLAYERS:
        COMPONENT = OVERLAY.getNameForDisplay(PLAYER) 

        if COMPONENT is None:
            continue

        text = str(COMPONENT.getString()).strip() 

        if "Alive:" in text or "Plots:" in text: # ISOLATE THE IMPORTANT DATAS
            RESULTS.append(text)
    
    PESTS_INFO = {}

    for VALUES in RESULTS:

        if "Alive:" in VALUES:
            PESTS_INFO["ALIVE"] = VALUES[7:]


        elif "Plots:" in VALUES:
            INFESTED_PLOTS = []
            CURRENT_NUMBER = ""
            PLOT_TEXT = VALUES[6:].strip()

            for PLOTS in range(len(PLOT_TEXT)):

                if PLOTS == len(PLOT_TEXT) - 1 and isDigit(PLOT_TEXT[PLOTS]):
                    CURRENT_NUMBER += PLOT_TEXT[PLOTS]
                    INFESTED_PLOTS.append(CURRENT_NUMBER)

                elif isDigit(PLOT_TEXT[PLOTS]):
                    CURRENT_NUMBER += PLOT_TEXT[PLOTS]

                elif PLOT_TEXT[PLOTS] == ",":
                    INFESTED_PLOTS.append(CURRENT_NUMBER)
                    CURRENT_NUMBER = ""

            PESTS_INFO["PLOTS"] = INFESTED_PLOTS

    return PESTS_INFO

getPest()
